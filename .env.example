# Docker Deployment Configuration (Copy as .env)
ARTEX_PORT=8791
ARTEX_PROXY_PORT=8788
ARTEX_DB_PORT=5434
POSTGRES_USER=artex
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=artex

# LLM (Choose one or both; also leave blank for UI)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ARTEX_LLM_PROVIDER=
ARTEX_LLM_MODEL=
ARTEX_LLM_BASE_URL=
ARTEX_LLM_PROXY=
# Optional override for a model server running on this computer:
# DOCKER_LLM_BASE_URL=http://host.docker.internal:1234/v1

# Stdio MCP is denied unless the exact absolute command, args and environment are
# approved here. See docs/security-remediation.md for the bundled browser recipes.
ARTEX_MCP_STDIO_ALLOWLIST=[]
# Optional stable recording-proxy password (at least 32 bytes). Blank generates a
# fresh random password at startup; agent/browser clients receive it internally.
ARTEX_PROXY_TOKEN=
